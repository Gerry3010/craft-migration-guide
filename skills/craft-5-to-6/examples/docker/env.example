# Copy to .env next to compose.yml. Generate secrets, never commit them.
APP_NAME="My Site"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=
APP_URL=https://example.com
PRIMARY_SITE_URL=https://example.com

# Behind the host's reverse proxy (see bootstrap/app.php in GUIDE.md)
TRUSTED_PROXIES=*

CRAFT_ENVIRONMENT=production
CRAFT_APP_ID=my-site
CRAFT_ALLOW_ADMIN_CHANGES=false

# MariaDB: must be "mariadb", not "mysql"
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=craft
DB_USERNAME=craft
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
LOG_CHANNEL=daily

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
